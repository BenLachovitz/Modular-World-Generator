# =========================================================
# Unity
# =========================================================
# This file is intended to be placed at the root of a repository
# that may contain the Unity project inside a subfolder.

**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They may also contain sensitive runtime data.
**/[Mm]emoryCaptures/

# Recordings can get excessive in size.
**/[Rr]ecordings/

# Uncomment if you want to ignore Asset Store Tools.
# **/[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
**/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity generated / temporary files
**/ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files for debug symbols
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt

# Unity builds / exported packages
*.apk
*.aab
*.app
*.exe
*.x86_64

# Local Unity Supabase config - do not commit real project config
**/SupabaseLicenseConfig.asset
**/SupabaseLicenseConfig.asset.meta

# Important:
# Keep this ignored unless you intentionally want to publish Unity packages.
*.unitypackage

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
**/[Aa]ssets/[Ss]treamingAssets/aa.meta
**/[Aa]ssets/[Ss]treamingAssets/aa/*


# =========================================================
# IDEs / Editors
# =========================================================

# Visual Studio cache
.vs/

# JetBrains Rider / IntelliJ
.idea/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Consulo
.consulo/


# =========================================================
# Gradle / Android
# =========================================================

.gradle/


# =========================================================
# Python - License Manager
# =========================================================

__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/
ENV/

pip-log.txt
pip-delete-this-directory.txt

# Python build outputs
build/
dist/
*.egg-info/


# =========================================================
# Node / Supabase / TypeScript
# =========================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Deno lock file
# You may commit this if you want reproducible Deno/Supabase function dependencies.
# For your project, ignoring it is fine unless you intentionally manage versions with it.
deno.lock


# =========================================================
# Environment Variables / Secrets
# =========================================================

.env
.env.*
!.env.example

# Local secrets/config files
secrets.json
config.local.json
*.local.json

# Supabase local folders
supabase/.branches/
supabase/.temp/


# =========================================================
# OS generated files
# =========================================================

.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini


# =========================================================
# Archives / Local Backups
# =========================================================

*.zip
*.rar
*.7z
*.tar
*.gz

backup/
backups/
_old/
old/